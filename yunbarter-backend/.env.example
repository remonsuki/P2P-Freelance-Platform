# Copy to .env and fill in the PostgreSQL connection. Never commit .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=yunbarter
PGUSER=postgres
PGPASSWORD=
# Alternatively, set DATABASE_URL instead of the five PG variables.
# DATABASE_URL=postgresql://user:password@localhost:5432/yunbarter
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set NODE_ENV=production behind HTTPS to enable Secure cookies.
NODE_ENV=development
SESSION_TTL_HOURS=168
# Optional AI course drafts. Keep API keys on the backend. Gemini takes priority when configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# All payments use SKILL escrow. Keep disabled until contracts and RPC are ready.
CHAIN_ENABLED=false
CHAIN_ID=11155111
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional public RPC shown to wallets; never put a private backend RPC key here.
CHAIN_WALLET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_CONFIRMATIONS=2
# Set the first Sepolia block to scan, such as the escrow deployment block.
CHAIN_START_BLOCK=
SKILL_TOKEN_ADDRESS=0xF3A9Ad79A8bCDF5F58C4d79BADebB3F47715B009
SKILL_ESCROW_ADDRESS=
# Dedicated quote-signing wallet; never use a student's wallet or commit this key.
CHAIN_QUOTE_PRIVATE_KEY=

# New signups queue 30 SKILL and 0.0016 testnet ETH from a dedicated wallet.
STARTER_FUNDS_ENABLED=false
STARTER_FUNDS_PRIVATE_KEY=
# Optional override for the grant worker. Defaults to CHAIN_RPC_URL.
STARTER_FUNDS_RPC_URL=
