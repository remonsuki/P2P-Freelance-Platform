# Copy to .env and fill in the PostgreSQL connection. Never commit .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=yunbarter
PGUSER=postgres
PGPASSWORD=
# Alternatively, set DATABASE_URL instead of the five PG variables.
# DATABASE_URL=postgresql://user:password@localhost:5432/yunbarter
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set NODE_ENV=production behind HTTPS to enable Secure cookies.
NODE_ENV=development
SESSION_TTL_HOURS=168
# Deposit/withdraw endpoints are demo bookkeeping until real payments are integrated.
ENABLE_DEMO_PAYMENTS=true
