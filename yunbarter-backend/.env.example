# Copy to .env and fill in the PostgreSQL connection. Never commit .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=yunbarter
PGUSER=postgres
PGPASSWORD=
# Alternatively, set DATABASE_URL instead of the five PG variables.
# DATABASE_URL=postgresql://user:password@localhost:5432/yunbarter
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set NODE_ENV=production behind HTTPS to enable Secure cookies.
NODE_ENV=development
SESSION_TTL_HOURS=168
# All payments use SKILL escrow. Keep disabled until contracts and RPC are ready.
CHAIN_ENABLED=false
CHAIN_ID=11155111
CHAIN_RPC_URL=
# Optional public RPC shown to wallets; never put a private backend RPC key here.
# An unauthenticated local loopback RPC is provided automatically for local chains.
CHAIN_WALLET_RPC_URL=
CHAIN_CONFIRMATIONS=2
# Deployment block (0 for a local chain). History synchronizes in bounded batches.
CHAIN_START_BLOCK=0
SKILL_TOKEN_ADDRESS=0xF3A9Ad79A8bCDF5F58C4d79BADebB3F47715B009
SKILL_ESCROW_ADDRESS=
# Dedicated quote-signing wallet; never use a student's wallet or commit this key.
CHAIN_QUOTE_PRIVATE_KEY=
